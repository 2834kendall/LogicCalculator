	<TextNote TextNoteId="cb428671-fba9-42d3-b972-6673aaa350b9" LogicalCircuitId="71756e49-154e-4332-a59f-4ad0813c5525" X="50" Y="26" Width="3" Height="2" Note="&lt;FlowDocument TextAlignment=&quot;Left&quot; PagePadding=&quot;5,0,5,0&quot; AllowDrop=&quot;True&quot; NumberSubstitution.CultureSource=&quot;User&quot; xmlns=&quot;http://schemas.microsoft.com/winfx/2006/xaml/presentation&quot;&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-cr&quot;&gt;ESP&lt;/Run&gt;&lt;/Paragraph&gt;&lt;/FlowDocument&gt;" />
