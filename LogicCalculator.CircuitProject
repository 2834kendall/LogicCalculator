	<TextNote TextNoteId="b72d1ebb-b061-4b48-96b4-1a123f3cee3c" LogicalCircuitId="6de7fc96-0b1d-4a24-a333-642d38a4cf55" X="96" Y="46" Width="52" Height="26" Note="&lt;FlowDocument PagePadding=&quot;5,0,5,0&quot; AllowDrop=&quot;True&quot; NumberSubstitution.CultureSource=&quot;User&quot; xmlns=&quot;http://schemas.microsoft.com/winfx/2006/xaml/presentation&quot;&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;COMO PROBARLA   -   el reloj corre solo, no hay que contar flancos&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;FUNCION 1:  Y = X + b        F1=1  F0=1     inmediata, no toca nada mas&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;FUNCION 2:  Y = |X| + b      F1=1  F0=0     inmediata tambien&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;FUNCION 3:  Y = m*X + b      F1=0  F0=0&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;   1. pulso de RST  (subir y bajar)&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;   2. ponga X, K=m y b en los interruptores&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;   3. pulso de CARGA   -- IMPORTANTE: dejelo ABAJO otra vez&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;   4. suba INICIO y espere unos 4 segundos&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;   5. lea Y.   Ejemplo: X=5, m=3, b=2  -&amp;gt;  Y = 17&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;FUNCION 4:  Y = a*X^2 + b    F1=0  F0=1     son dos pasadas&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;   1. PASO abajo. Pulso de RST. Ponga X, K=a y b&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;   2. pulso de CARGA, suba INICIO, espere ~4 s&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;      (en el PRODUCTO debe aparecer X*X)&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;   3. BAJE INICIO&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;   4. pulso de CARGA P1     (guarda X*X)&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;   5. pulso de RST MUL      (borra el multiplicador, conserva X*X)&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;   6. suba PASO&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;   7. pulso de CARGA, suba INICIO, espere ~4 s&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;   8. lea Y.   Ejemplo: X=3, a=2, b=1  -&amp;gt;  Y = 19&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;Si algo no sale: casi siempre es que CARGA quedo arriba, o que en el&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;paso 3 de la funcion 4 no se bajo INICIO antes de RST MUL.&lt;/Run&gt;&lt;/Paragraph&gt;&lt;/FlowDocument&gt;" />
	<TextNote TextNoteId="4a83a755-58ce-445f-97cc-1b126808ad54" LogicalCircuitId="865dfb68-36f6-4ce7-82b2-7d8598a43d13" X="4" Y="90" Width="64" Height="13" Note="&lt;FlowDocument PagePadding=&quot;5,0,5,0&quot; AllowDrop=&quot;True&quot; NumberSubstitution.CultureSource=&quot;User&quot; xmlns=&quot;http://schemas.microsoft.com/winfx/2006/xaml/presentation&quot;&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;UNIDAD ARITMETICA - Persona A.&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;F1F0:  00 =&amp;gt; Y = m*X + b     01 =&amp;gt; Y = a*X^2 + b     10 =&amp;gt; Y = |X| + b     11 =&amp;gt; Y = X + b&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;E1E0 = ajuste de escala (0 a 3 desplazamientos a la derecha del producto de 16 bits).&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;Las funciones 10 y 11 son combinacionales. Las otras dos usan el multiplicador.&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;Secuencia: RST -&amp;gt; fijar X, K, b, F, E -&amp;gt; pulso de CARGA -&amp;gt; INICIO=1 -&amp;gt; 17 ciclos de reloj.&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;Para a*X^2 hay dos multiplicaciones: 1) PASO=0, se calcula |X|*|X|; 2) baje INICIO, pulso de CARGA P1 (guarda X^2), pulso de RST MUL (borra solo el multiplicador), suba PASO, CARGA, INICIO otra vez.&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;Las salidas P ALTO y P BAJO muestran el producto crudo del multiplicador; sirven para ver si la multiplicacion corrio.&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;X y b van en complemento a 2. K (m o a) es magnitud; el signo de X se aplica al final por la entrada SW del sumador/restador, solo para m*X.&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;En todos los buses: bit 0 = LSB.&lt;/Run&gt;&lt;/Paragraph&gt;&lt;/FlowDocument&gt;" />
	<TextNote TextNoteId="90150197-5862-4078-bc18-fd7d1dcca4a3" LogicalCircuitId="cc47d8eb-5644-4c31-96ec-4c5c4fbc8c10" X="1" Y="28" Width="11" Height="4" Note="&lt;FlowDocument TextAlignment=&quot;Left&quot; PagePadding=&quot;5,0,5,0&quot; AllowDrop=&quot;True&quot; NumberSubstitution.CultureSource=&quot;User&quot; xmlns=&quot;http://schemas.microsoft.com/winfx/2006/xaml/presentation&quot; xmlns:x=&quot;http://schemas.microsoft.com/winfx/2006/xaml&quot;&gt;&lt;Paragraph&gt;&lt;Run FontFamily=&quot;Calibri&quot; FontWeight=&quot;Bold&quot; xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;FSEL0 &lt;/Run&gt;&lt;Run FontFamily=&quot;Calibri&quot; xml:lang=&quot;es-mx&quot;&gt;-&amp;gt; Function Select del bit 0&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run FontFamily=&quot;Calibri&quot; xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot; /&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run FontFamily=&quot;Calibri&quot; FontWeight=&quot;Bold&quot; xml:lang=&quot;es-mx&quot;&gt;FSEL1&lt;/Run&gt;&lt;Run FontFamily=&quot;Calibri&quot; xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt; -&amp;gt; Function Select del bit 1&lt;/Run&gt;&lt;/Paragraph&gt;&lt;/FlowDocument&gt;" />
	<TextNote TextNoteId="0c82d02e-9f40-4d5b-80db-c99916b6f164" LogicalCircuitId="cc47d8eb-5644-4c31-96ec-4c5c4fbc8c10" X="1" Y="37" Width="14" Height="12" Note="&lt;FlowDocument TextAlignment=&quot;Left&quot; PagePadding=&quot;5,0,5,0&quot; AllowDrop=&quot;True&quot; NumberSubstitution.CultureSource=&quot;User&quot; xmlns=&quot;http://schemas.microsoft.com/winfx/2006/xaml/presentation&quot; xmlns:x=&quot;http://schemas.microsoft.com/winfx/2006/xaml&quot;&gt;&lt;Paragraph&gt;&lt;Run FontFamily=&quot;Calibri&quot; FontWeight=&quot;Bold&quot; xml:lang=&quot;es-mx&quot;&gt;M_A0&lt;/Run&gt;&lt;Run FontFamily=&quot;Calibri&quot; xml:lang=&quot;es-mx&quot;&gt;-&amp;gt; pendiente + factor de la parábola (bit 0)&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run FontFamily=&quot;Calibri&quot; xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot; /&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run FontFamily=&quot;Calibri&quot; FontWeight=&quot;Bold&quot; xml:lang=&quot;es-mx&quot;&gt;M_A1&lt;/Run&gt;&lt;Run FontFamily=&quot;Calibri&quot; xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt; -&amp;gt; pendiente + factor de la parábola (bit 1)&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run FontFamily=&quot;Calibri&quot; xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot; /&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run FontFamily=&quot;Calibri&quot; FontWeight=&quot;Bold&quot; xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;M_A2 &lt;/Run&gt;&lt;Run FontFamily=&quot;Calibri&quot; xml:lang=&quot;es-mx&quot;&gt;-&amp;gt; pendiente + factor de la parábola (bit 2)&lt;/Run&gt;&lt;/Paragraph&gt;&lt;/FlowDocument&gt;" />
	<TextNote TextNoteId="30601808-f132-49f5-9c8d-1db61b2b50c7" LogicalCircuitId="cc47d8eb-5644-4c31-96ec-4c5c4fbc8c10" X="28" Y="20" Width="11" Height="4" Note="&lt;FlowDocument TextAlignment=&quot;Left&quot; PagePadding=&quot;5,0,5,0&quot; AllowDrop=&quot;True&quot; NumberSubstitution.CultureSource=&quot;User&quot; xmlns=&quot;http://schemas.microsoft.com/winfx/2006/xaml/presentation&quot;&gt;&lt;Paragraph&gt;&lt;Run FontWeight=&quot;Bold&quot; xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;B_PARAM -&amp;gt; &lt;/Run&gt;&lt;Run xml:lang=&quot;es-mx&quot;&gt;Parámetro de 'b' para el desplazamiento (de bit 0 a bit 3)&lt;/Run&gt;&lt;/Paragraph&gt;&lt;/FlowDocument&gt;" />
	<TextNote TextNoteId="8cf141d0-2ba8-41dc-9a03-7a6526b470b8" LogicalCircuitId="cc47d8eb-5644-4c31-96ec-4c5c4fbc8c10" X="41" Y="20" Width="13" Height="8" Note="&lt;FlowDocument TextAlignment=&quot;Left&quot; PagePadding=&quot;5,0,5,0&quot; AllowDrop=&quot;True&quot; NumberSubstitution.CultureSource=&quot;User&quot; xmlns=&quot;http://schemas.microsoft.com/winfx/2006/xaml/presentation&quot;&gt;&lt;Paragraph&gt;&lt;Run FontWeight=&quot;Bold&quot; xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;DISP_SEL &lt;/Run&gt;&lt;Run xml:lang=&quot;es-mx&quot;&gt;-&amp;gt; selecciona el valor que muestran los displays&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot; /&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot; /&gt;&lt;/Paragraph&gt;&lt;/FlowDocument&gt;" />
	<TextNote TextNoteId="df7d5a82-e914-4196-863c-2a33914cd8f4" LogicalCircuitId="56ce62cf-63fe-4fed-abef-9ff05804978c" X="20" Y="6" Width="50" Height="9" Note="&lt;FlowDocument PagePadding=&quot;5,0,5,0&quot; AllowDrop=&quot;True&quot; NumberSubstitution.CultureSource=&quot;User&quot; xmlns=&quot;http://schemas.microsoft.com/winfx/2006/xaml/presentation&quot;&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;NO METER INVERSORES AQUI.&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;Este sumador usa el convenio bit 0 = LSB, que es el correcto y el que usa todo el resto del proyecto.&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;El problema de orden de bits del multiplicador YA esta resuelto con cuatro Inversores dentro de Multiplier Register y Extended accumulator.&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;Si ademas se ponen Inversores en las entradas A y B de aqui, los dos arreglos se anulan: el sumador deja de sumar (3 + 5 daba 96) y con el se caen el multiplicador y las cuatro funciones de la ALU.&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;Ya paso dos veces. Si el multiplicador vuelve a fallar, lo primero que hay que revisar es que este circuito no tenga Inversores en A ni en B.&lt;/Run&gt;&lt;/Paragraph&gt;&lt;/FlowDocument&gt;" />
	<TextNote TextNoteId="b303e561-9ce6-4f6e-b3df-523d5fbfdf86" LogicalCircuitId="8ac329ce-a706-4b3f-922c-fca6ddeaabce" X="30" Y="62" Width="42" Height="7" Note="&lt;FlowDocument PagePadding=&quot;5,0,5,0&quot; AllowDrop=&quot;True&quot; NumberSubstitution.CultureSource=&quot;User&quot; xmlns=&quot;http://schemas.microsoft.com/winfx/2006/xaml/presentation&quot;&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;Los dos INVERSORES (entrada Bin y salida Q) alinean este registro con el sumador: bit 0 = LSB.&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;Sin ellos el registro trataba el bit 7 del bus como LSB mientras el Ripple Carry trata el bit 0 como LSB, y el acarreo se propagaba al reves. NO QUITARLOS.&lt;/Run&gt;&lt;/Paragraph&gt;&lt;/FlowDocument&gt;" />
	<TextNote TextNoteId="b9b385d5-ba33-4b6c-895e-4740ad8fb57a" LogicalCircuitId="57113a72-9c41-4574-aafe-d0a3f7381420" X="30" Y="62" Width="42" Height="7" Note="&lt;FlowDocument PagePadding=&quot;5,0,5,0&quot; AllowDrop=&quot;True&quot; NumberSubstitution.CultureSource=&quot;User&quot; xmlns=&quot;http://schemas.microsoft.com/winfx/2006/xaml/presentation&quot;&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;Los dos INVERSORES (entrada SUM y salida Q) alinean el acumulador con el sumador: bit 0 = LSB.&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-mx&quot; xml:space=&quot;preserve&quot;&gt;Con ellos el desplazamiento a la derecha E -&amp;gt; A -&amp;gt; Q y la suma A + M usan el mismo orden de bits. NO QUITARLOS.&lt;/Run&gt;&lt;/Paragraph&gt;&lt;/FlowDocument&gt;" />
